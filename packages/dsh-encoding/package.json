{
  "name": "dsh-encoding",
  "version": "0.1.0",
  "description": "Source-file encoding repair for DeepSeek Harness: restores the UTF-8 BOM required by non-ASCII C/C++/CMake sources and normalizes line endings to CRLF while preserving the original terminator of every untouched line.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test build/test/*.test.js",
    "check": "npm run build && npm test"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
